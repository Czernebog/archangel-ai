{
  "name": "archangel-ai-desktop",
  "version": "7.2.0",
  "private": true,
  "description": "ARCHANGEL AI Desktop for Windows",
  "author": "Czernebog",
  "license": "UNLICENSED",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ai.czernebog.archangel",
    "productName": "ARCHANGEL AI",
    "copyright": "Copyright © 2026 Czernebog",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ARCHANGEL-AI-Setup-${version}.${ext}",
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ARCHANGEL AI"
    }
  }
}
